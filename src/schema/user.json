{
  "type": "content-type",
  "collectionName": "users",
  "attributes": {
    "firstName": { "type": "string", "required": true },
    "lastName": { "type": "string", "required": true },
    "email": { "type": "string", "required": true },
    "isActive": { "type": "boolean", "required": false },
    "age": { "type": "number", "required": false },
    "tags": { "type": "array", "itemsType": "string", "required": false },
    "scores": { "type": "array", "itemsType": "number", "required": false },
    "addresses": { "type": "array", "itemsType": "object", "required": false },
    "profile": { "type": "object", "required": false },
    "button": {
      "type": "component",
      "repeatable": false,
      "component": "button"
    }
  }
}
